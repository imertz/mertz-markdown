# Copy to .env on the VPS. Generate two different secrets with `openssl rand -hex 32`.
SYNC_ADMIN_TOKEN=replace-with-a-random-admin-secret
SYNC_RATE_LIMIT_SECRET=replace-with-a-different-random-secret
SYNC_REGISTRATION_ENABLED=true
SYNC_MAX_VAULTS=80
SYNC_VAULT_QUOTA_BYTES=524288000
SYNC_REGISTRATION_ATTEMPTS_PER_HOUR=10
SYNC_REGISTRATIONS_PER_IP_PER_DAY=3
SYNC_MAX_ACTIVE_PAIRINGS=8
SYNC_MAX_ACTIVE_DEVICES=8
SYNC_DEVICE_REQUESTS_PER_MINUTE=600
SYNC_ALLOWED_ORIGINS=https://markdown.mysolon.gr
SYNC_MAX_OBJECT_BYTES=31457280
